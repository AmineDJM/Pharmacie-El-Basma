# ----------------------------------------------------------------------------
# Parapharmacie El Basma — Variables d'environnement
# Copiez ce fichier en `.env` puis renseignez les valeurs.
# ----------------------------------------------------------------------------

# Base de données PostgreSQL (Render fournit cette URL automatiquement en prod).
# En local avec docker-compose : postgresql://elbasma:elbasma@localhost:5432/elbasma
DATABASE_URL="postgresql://elbasma:elbasma@localhost:5432/elbasma?schema=public"

# Clé secrète utilisée pour signer les sessions admin (générez une valeur longue et aléatoire).
# Exemple de génération : openssl rand -base64 48
SESSION_SECRET="changez-moi-pour-une-chaine-aleatoire-tres-longue-et-secrete"

# Identifiants du compte administrateur créés au premier démarrage (seed).
ADMIN_EMAIL="admin@parapharmacie-elbasma.dz"
ADMIN_PASSWORD="ElBasma2024!"

# URL publique du site (utilisée pour le SEO, les sitemaps, OpenGraph, JSON-LD).
NEXT_PUBLIC_SITE_URL="https://parapharmacie-elbasma.dz"

# Coordonnées de contact (peuvent aussi être modifiées dans l'espace admin > Paramètres).
NEXT_PUBLIC_PHONE="+213 25 00 00 00"
NEXT_PUBLIC_WHATSAPP="213660000000"
